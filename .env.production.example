# You normally never write this file by hand: `./deploy/install.sh` generates
# .env.production with every secret below already filled in with a random value
# on first run, and reuses it untouched on every later run. This file is a
# reference for what gets generated (and a manual fallback if you'd rather not
# use install.sh) — see deploy/DEPLOYMENT.md.

DJANGO_SETTINGS_MODULE=config.settings.production

# install.sh generates this with `openssl rand -hex 32`.
SECRET_KEY=

# Wildcarded by default (config/settings/production.py) — a fresh install doesn't
# need a hostname decided up front. Set a comma-separated list here to tighten it.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# install.sh generates BOOTSTRAP_ADMIN_PASSWORD with `openssl rand -hex 12` and
# prints it once at the end of the install. Production startup rejects a missing
# value or the literal "admin" here.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# The migration-owning role — creates/owns every table, runs `manage.py migrate`.
# install.sh generates POSTGRES_PASSWORD with `openssl rand -hex 16`.
POSTGRES_DB=stock_inventory
POSTGRES_USER=stock_inventory
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Optional, recommended: a separate lower-privilege role the running app connects
# as day to day, with UPDATE/DELETE revoked on the ledger/audit tables — defense
# in depth per docs/architecture/08-nonfunctional-plan.md. Provision it with
# deploy/sql/hardening_runtime_role.sql (after the first `manage.py migrate`), then
# set these two so the app stops connecting as the owning role. Leave both blank
# to skip this hardening layer (the app then falls back to POSTGRES_USER above).
RUNTIME_DB_USER=
RUNTIME_DB_PASSWORD=

# Session/security (defaults shown are docs/architecture/08's deferred-and-defaulted
# choices — spec §24 — adjust if your organization has a firmer policy).
SESSION_COOKIE_AGE=28800
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_PRELOAD=False

# Login throttling (docs/architecture/08).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# Structured JSON logging is on by default in production.py; LOG_LEVEL/DJANGO_LOG_LEVEL
# tune verbosity if needed (default INFO).
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
