POSTGRES_PORT=5432

CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Optional: fixed passwords for `manage.py seed_dev_data`. Leave blank to have
# the command generate and print a random password for each seeded user.
SEED_ADMIN_PASSWORD=
