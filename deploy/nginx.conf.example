# Example reverse-proxy config for deploy/docker-compose.prod.yml's `proxy` service.
# Copy to nginx.conf (gitignored — it will reference your real hostname/cert
# paths) and adjust the server_name and certificate paths before use.
#
# TLS certificates: this file expects them already present under ./certs
# (mounted read-only into the container) — e.g. from your organization's
# existing CA, or obtained separately via certbot in webroot/DNS mode and
# copied in. Automating ACME issuance is intentionally out of scope here
# (spec §3's "avoid unnecessary complexity" — a one-time manual or
# separately-scripted cert renewal job is enough for an internal tool with a
# small, known set of users).

server {
    listen 80;
    server_name _;
    # Django's own SECURE_SSL_REDIRECT (config/settings/production.py) also
    # redirects http->https at the application level; redirecting here too
    # means a misconfigured app-level setting doesn't leave port 80 serving
    # the app in the clear.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 15M;  # matches apps.documents.services.MAX_ATTACHMENT_SIZE_BYTES headroom

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Required: config/settings/production.py's SECURE_PROXY_SSL_HEADER
        # trusts this header to decide the request was HTTPS — never remove
        # it, and never let an untrusted client set it directly (nginx
        # overwrites any client-supplied value here, which is what makes
        # trusting it from Django safe).
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
