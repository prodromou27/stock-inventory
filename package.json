{
  "name": "stock-inventory-assets",
  "private": true,
  "description": "Tailwind CSS build for static/css/app.css — see CLAUDE.md's 'Frontend build (Tailwind CSS)' section.",
  "scripts": {
    "build:vendor": "node assets/build-vendor.cjs",
    "build:css": "tailwindcss -i ./assets/tailwind/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/tailwind/input.css -o ./static/css/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "font-awesome": "4.7.0",
    "grapesjs": "0.22.16",
    "tabulator-tables": "^6.5.2",
    "tom-select": "^2.6.2"
  }
}
